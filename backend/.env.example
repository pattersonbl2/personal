# Resend (https://resend.com) - free tier: 100 emails/day
RESEND_API_KEY=re_xxxxxxxx
CONTACT_EMAIL=you@example.com

# Optional: custom From address (must be verified in Resend)
# Default: Contact Form <onboarding@resend.dev>
# RESEND_FROM=Contact <onboarding@yourdomain.com>

# Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/)
# Secret lives on Cloud Run only. Site key is public (Hugo/Cloudflare Pages build env).
# Dummy always-pass keys for local testing:
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=0x_your_secret_key
# TURNSTILE_SITE_KEY is set in the Pages/Hugo build environment (not required by the API).

# Resume PDF download (token must match resumeDownloadURL in Hugo config)
# RESUME_TOKEN must be set in production; never leave empty or use "placeholder" for prod
RESUME_TOKEN=placeholder
RESUME_PDF_PATH=resume.pdf

# Optional: restrict CORS (comma-separated, e.g. https://yoursite.com,https://www.yoursite.com)
# If unset, allows all origins
# ALLOWED_ORIGINS=https://yoursite.com
